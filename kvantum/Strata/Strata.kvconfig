[%General]
author=Strata
comment=Strata — thème pixel original, bois / herbe / pierre
x11drag=menubar_and_primary_toolbar
alt_mnemonic=true
left_tabs=true
attach_active_tab=false
group_toolbar_buttons=false
spread_progressbar=true
progressbar_thickness=12
composite=true
menu_shadow_depth=0
tooltip_shadow_depth=0
spread_menuitems=true
splitter_width=7
scroll_width=14
scroll_min_extent=40
scroll_arrows=false
combo_as_lineedit=false
combo_menu=true
inline_spin_indicators=true
vertical_spin_indicators=false
slider_width=8
slider_handle_width=16
slider_handle_length=16
check_size=16
tooltip_delay=-1
toolbar_icon_size=22
small_icon_size=16
large_icon_size=32
button_icon_size=16
animate_states=false
no_inactiveness=false
transient_scrollbar=false
transient_groove=false
translucent_windows=false
blurring=false
popup_blurring=false
reduce_window_opacity=0
reduce_menu_opacity=0
menu_separator_height=7
fill_rubberband=true
respect_DE=true
dialog_button_layout=0
click_behavior=0
contrast=1.00
intensity=1.00
saturation=1.00

[GeneralColors]
window.color=#2B2118
base.color=#1F1812
alt.base.color=#241C14
button.color=#3A2C20
light.color=#8B6A47
mid.light.color=#5C4630
dark.color=#120D08
mid.color=#4A3420
shadow.color=#120D08
highlight.color=#3E5A26
inactive.highlight.color=#2F3A1F
tooltip.base.color=#3A2C20
text.color=#EDE3CF
window.text.color=#EDE3CF
button.text.color=#EDE3CF
disabled.text.color=#7D6E58
tooltip.text.color=#EDE3CF
highlight.text.color=#EDE3CF
link.color=#7FB2E5
link.visited.color=#B58AD6
progress.indicator.text.color=#120D08

[Hacks]
respect_darkness=true
transparent_ktitle_label=true
transparent_dolphin_view=false
blur_konsole=false
transparent_menutitle=true
middle_click_scroll=true
normal_default_pushbutton=true
iconless_pushbutton=false
tint_on_mouseover=0
no_selection_tint=true
disabled_icon_opacity=60
lxqtmainmenu_iconsize=0
style_vertical_toolbars=false

[PanelButtonCommand]
frame=true
frame.element=button
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
interior=true
interior.element=button
indicator.size=9
text.normal.color=#EDE3CF
text.focus.color=#EDE3CF
text.press.color=#7CCB4A
text.toggle.color=#7CCB4A
text.disabled.color=#7D6E58
text.shadow=0
text.margin=1
text.iconspacing=5
indicator.element=arrow
text.margin.top=2
text.margin.bottom=2
text.margin.left=6
text.margin.right=6
min_height=+4
min_width=+8

[PanelButtonTool]
inherits=PanelButtonCommand
frame.element=tbutton
interior.element=tbutton
text.margin.left=3
text.margin.right=3

[ToolbarButton]
inherits=PanelButtonTool
text.normal.color=#EDE3CF
text.focus.color=#EDE3CF

[Dock]
inherits=PanelButtonCommand
frame=false
interior=false

[DockTitle]
inherits=PanelButtonCommand
frame=false
interior=false
text.bold=true
text.normal.color=#B8A88C
text.focus.color=#EDE3CF

[IndicatorSpinBox]
inherits=PanelButtonCommand
frame=true
interior=true
frame.element=tbutton
interior.element=tbutton
indicator.element=arrow
indicator.size=9

[RadioButton]
inherits=PanelButtonCommand
frame=false
interior.element=radio
text.press.color=#EDE3CF
text.toggle.color=#EDE3CF
text.margin.left=2
text.margin.right=2

[CheckBox]
inherits=PanelButtonCommand
frame=false
interior.element=checkbox
text.press.color=#EDE3CF
text.toggle.color=#EDE3CF
text.margin.left=2
text.margin.right=2

[GenericFrame]
inherits=PanelButtonCommand
frame=true
interior=false
frame.element=common
interior.element=common
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4

[LineEdit]
inherits=PanelButtonCommand
frame.element=lineedit
interior.element=lineedit
text.margin.left=4
text.margin.right=4
text.press.color=#EDE3CF
text.toggle.color=#EDE3CF

[DropDownButton]
inherits=PanelButtonCommand
indicator.element=arrow

[IndicatorArrow]
indicator.element=arrow
indicator.size=9

[ToolboxTab]
inherits=PanelButtonCommand

[Tab]
inherits=PanelButtonCommand
frame.element=tab
interior.element=tab
indicator.element=arrow
text.normal.color=#B8A88C
text.focus.color=#EDE3CF
text.press.color=#EDE3CF
text.toggle.color=#7CCB4A
text.margin.left=10
text.margin.right=10
text.margin.top=3
text.margin.bottom=3
min_height=+6
min_width=+8

[TabFrame]
inherits=PanelButtonCommand
frame.element=tabframe
interior.element=tabframe
interior=true

[TabBarFrame]
inherits=GenericFrame
frame=false
interior=false

[TreeExpander]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.size=9
indicator.element=arrow

[HeaderSection]
inherits=PanelButtonCommand
frame.element=header
interior.element=header
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
text.press.color=#EDE3CF
text.toggle.color=#EDE3CF
text.bold=true

[SizeGrip]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.element=resize-grip
indicator.size=7

[Toolbar]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.element=toolbar
indicator.size=5
text.margin=0

[MenuBar]
inherits=PanelButtonCommand
frame=false
interior=false

[MenuBarItem]
inherits=PanelButtonCommand
frame.element=menubaritem
interior.element=menubaritem
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
text.margin.left=6
text.margin.right=6
text.focus.color=#EDE3CF
text.press.color=#EDE3CF
text.toggle.color=#EDE3CF

[Menu]
inherits=PanelButtonCommand
frame.element=menu
interior.element=menu
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
text.press.color=#EDE3CF
text.toggle.color=#EDE3CF

[MenuItem]
inherits=PanelButtonCommand
frame=true
frame.element=menuitem
interior.element=menuitem
indicator.element=menuitem
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
text.margin.top=2
text.margin.bottom=2
text.margin.left=6
text.margin.right=6
text.focus.color=#EDE3CF
text.press.color=#EDE3CF
text.toggle.color=#EDE3CF
min_height=+4

[Slider]
inherits=PanelButtonCommand
frame.element=slider
interior.element=slider
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4

[SliderCursor]
inherits=PanelButtonCommand
frame=false
interior.element=slidercursor

[Progressbar]
inherits=PanelButtonCommand
frame.element=progress
interior.element=progress
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
text.margin=0
text.normal.color=#EDE3CF
text.focus.color=#EDE3CF
text.press.color=#EDE3CF
text.toggle.color=#EDE3CF
text.bold=true

[ProgressbarContents]
inherits=PanelButtonCommand
frame=true
frame.element=progress-pattern
interior.element=progress-pattern
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2

[ItemView]
inherits=PanelButtonCommand
frame.element=itemview
interior.element=itemview
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
text.margin.top=2
text.margin.bottom=2
text.margin.left=4
text.margin.right=4
text.normal.color=#EDE3CF
text.focus.color=#EDE3CF
text.press.color=#EDE3CF
text.toggle.color=#EDE3CF
min_width=+4
min_height=+4

[Splitter]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.element=splitter-grip
indicator.size=9

[Scrollbar]
inherits=PanelButtonCommand
indicator.element=arrow
indicator.size=9

[ScrollbarSlider]
inherits=PanelButtonCommand
frame.element=scrollbarslider
interior.element=scrollbarslider
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
indicator.element=grip
indicator.size=0

[ScrollbarGroove]
inherits=PanelButtonCommand
frame.element=scrollbargroove
interior.element=scrollbargroove
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4

[TitleBar]
inherits=PanelButtonCommand
frame=false
interior=false
text.bold=true

[ComboBox]
inherits=PanelButtonCommand
text.press.color=#EDE3CF
text.toggle.color=#EDE3CF

[GroupBox]
inherits=GenericFrame
frame=true
frame.element=group
interior=true
interior.element=group
text.shadow=0
text.margin=0
text.bold=true
text.normal.color=#E8B23A
text.focus.color=#E8B23A

[ToolTip]
inherits=GenericFrame
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
interior=true
text.shadow=0
text.margin=2
frame.element=tooltip
interior.element=tooltip

[StatusBar]
inherits=GenericFrame
frame=false
interior=false

[Window]
interior=false
frame=false
